# DOMAIN .env faylida: masalan tishduxtir.uz. Caddy HTTPS sertifikatini o'zi oladi (Let's Encrypt).
{
	servers {
		# Oldida Nginx bo'lsa, foydalanuvchining haqiqiy IP manzili X-Forwarded-For dan olinadi.
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 30MB
	}
}
