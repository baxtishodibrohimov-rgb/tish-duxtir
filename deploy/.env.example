# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
# Domeningiz (DNS A yozuvi server IP manziliga yo'naltirilgan bo'lishi kerak)
DOMAIN=tishduxtir.uz

# Uzun tasodifiy qiymatlar. Yaratish: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Serverda Nginx 80/443 ni egallagan bo'lsa (README: "Serverda Nginx bo'lsa"):
# DOMAIN=:80
# HTTP_BIND=127.0.0.1:8090
# HTTPS_BIND=127.0.0.1:8453

# Ixtiyoriy
BACKUP_KEEP_DAYS=14
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
